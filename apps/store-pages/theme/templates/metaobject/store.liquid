{%- comment -%} GA4 (Option A: gtag in the theme) — POC CTA tracking. Replace ga4_id above. {%- endcomment -%}
{%- if ga4_id != blank -%}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('js', new Date());
  // debug_mode:true → these events show up in GA4 DebugView (Sandbox only, since it
  // lives on this theme). Use the "Debug devices" selector to isolate your device.
  gtag('config', {{ ga4_id | json }}, { debug_mode: true });

  (function () {
    var STORE = { store_id: {{ metaobject.store_id.value | json }}, store_name: {{ metaobject.name.value | json }} };

    // CTA + nearby clicks — delegated so dynamically-rendered nearby links are covered.
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('[data-ga]') : null;
      if (!el) return;
      var params = { store_id: STORE.store_id, store_name: STORE.store_name };
      if (el.getAttribute('data-ga-group')) params.category = el.getAttribute('data-ga-group');
      if (el.getAttribute('data-ga') === 'nearby_click') params.poi_name = (el.textContent || '').trim();
      if (el.getAttribute('data-ga') === 'nearby_store_click') {
        params.target_store_id = el.getAttribute('data-ga-target');
        params.target_store_name = (el.textContent || '').trim();
      }
      gtag('event', el.getAttribute('data-ga'), params);
    });

    // Weekly hours expand (fires when the <details> opens).
    document.querySelectorAll('.store-page__hours').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) gtag('event', 'hours_expand', { store_id: STORE.store_id, store_name: STORE.store_name });
      });
    });
  })();
</script>
{%- endif -%}
