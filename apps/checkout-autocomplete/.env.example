# App client secret — used to verify the App Proxy HMAC signature.
# (Provided by the app; the Shopify CLI also sets this in dev.)
SHOPIFY_API_SECRET=

# 32-byte base64 key that encrypts the merchant's Woosmap key at rest.
# Generate with:  openssl rand -base64 32
SETTINGS_ENC_KEY=

# NOTE: the Woosmap PRIVATE key is NOT set here. It is entered per-shop in the
# admin UI and stored encrypted (see woosmap-settings.server.ts). For local
# testing you may seed it once via setWoosmapPrivateKey(shop, key).
