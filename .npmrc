# Node 23 (this env) is not in vitest 4's declared engines range but works fine;
# don't hard-fail installs on the engines field.
engine-strict=false
shamefully-hoist=true

# Delay newly published versions if anyone installs with npm instead of pnpm
# (npm >= 11.10). pnpm's equivalent is minimumReleaseAge in pnpm-workspace.yaml.
min-release-age=7
